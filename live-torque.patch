@@ -0,0 +1,93 @@
+package com.my.kizzy.feature_rpc_base.services
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.os.IBinder
+import com.my.kizzy.domain.model.rpc.RpcConfig
+import org.prowl.torque.remote.ITorqueService
+
+/**
+ * Reads live values from the Torque Pro app through its plugin service (AIDL),
+ * the same way the AA Torque app does. Torque must be running and connected to the car.
+ */
+class TorqueReader(private val context: Context) {
+    @Volatile
+    private var torque: ITorqueService? = null
+    private var bound = false
+
+    private val connection = object : ServiceConnection {
+        override fun onServiceConnected(name: ComponentName, service: IBinder) {
+            torque = ITorqueService.Stub.asInterface(service)
+        }
+
+        override fun onServiceDisconnected(name: ComponentName) {
+            torque = null
+        }
+    }
+
+    fun bind() {
+        if (bound) return
+        val intent = Intent()
+        intent.setClassName("org.prowl.torque", "org.prowl.torque.remote.TorqueService")
+        bound = try {
+            context.bindService(intent, connection, Context.BIND_AUTO_CREATE)
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    fun unbind() {
+        if (bound) {
+            try {
+                context.unbindService(connection)
+            } catch (_: Exception) {
+            }
+            bound = false
+        }
+        torque = null
+    }
+
+    /** Returns (speed, rpm). A value is null when Torque is not available or not connected to the car. */
+    fun read(): Pair<Double?, Double?> {
+        val service = torque ?: return Pair(null, null)
+        return try {
+            if (!service.isConnectedToECU()) return Pair(null, null)
+            val values = service.getPIDValuesAsDouble(arrayOf(PID_SPEED, PID_RPM))
+            Pair(values.getOrNull(0), values.getOrNull(1))
+        } catch (e: Exception) {
+            Pair(null, null)
+        }
+    }
+
+    companion object {
+        // Same PID ids that AA Torque uses by default ("<pid>,<display index>")
+        const val PID_SPEED = "0d,0"
+        const val PID_RPM = "0c,0"
+    }
+}
+
+/** Placeholders that can be used in the text fields of a Custom RPC profile. */
+object LiveTemplate {
+    const val SPEED = "{speed}"
+    const val RPM = "{rpm}"
+
+    fun hasLive(text: String?): Boolean =
+        text != null && (text.contains(SPEED) || text.contains(RPM))
+
+    fun usesLive(cfg: RpcConfig): Boolean =
+        listOf(cfg.name, cfg.details, cfg.state, cfg.largeText, cfg.smallText).any { hasLive(it) }
+
+    fun resolve(text: String, speed: Double?, rpm: Double?): String =
+        text.replace(SPEED, speed?.let { Math.round(it).toString() } ?: "--")
+            .replace(RPM, rpm?.let { Math.round(it).toString() } ?: "--")
+
+    fun resolveConfig(cfg: RpcConfig, speed: Double?, rpm: Double?): RpcConfig = cfg.copy(
+        name = resolve(cfg.name, speed, rpm),
+        details = resolve(cfg.details, speed, rpm),
+        state = resolve(cfg.state, speed, rpm),
+        largeText = resolve(cfg.largeText, speed, rpm),
+        smallText = resolve(cfg.smallText, speed, rpm),
+    )
+}
