+
+/** Dropdown to switch a field between your own text and live values from Torque. */
+@Composable
+private fun LiveValueMenu(value: String, onValueChange: (String) -> Unit) {
+    var expanded by remember { mutableStateOf(false) }
+
+    fun append(token: String) {
+        onValueChange(if (value.isEmpty()) token else "$value $token")
+        expanded = false
+    }
+
+    IconButton(onClick = { expanded = true }) {
+        Icon(imageVector = Icons.Filled.ArrowDropDown, contentDescription = "Live values")
+    }
+    DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
+        DropdownMenuItem(
+            text = { Text("Custom text (clear field)") },
+            onClick = {
+                onValueChange("")
+                expanded = false
+            }
+        )
+        DropdownMenuItem(text = { Text("Live speed") }, onClick = { append("{speed}") })
+        DropdownMenuItem(text = { Text("Live RPM") }, onClick = { append("{rpm}") })
+        DropdownMenuItem(
+            text = { Text("Live speed + RPM") },
+            onClick = { append("{speed} km/h \u00b7 {rpm} rpm") }
+        )
+    }
+}
