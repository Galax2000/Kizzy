+
+    /**
+     * Re-sends the running presence with new text values only.
+     * Images, buttons, timestamps and the rest stay exactly as they were built.
+     */
+    suspend fun updateLiveText(
+        name: String?,
+        details: String?,
+        state: String?,
+        largeText: String?,
+        smallText: String?
+    ) {
+        if (!::presence.isInitialized || !discordWebSocket.isActive) return
+        val current = presence.activities?.firstOrNull() ?: return
+        val updated = presence.copy(
+            activities = listOf(
+                current.copy(
+                    name = name ?: current.name,
+                    details = details?.takeIf { it.isNotEmpty() }?.sanitize(),
+                    state = state?.takeIf { it.isNotEmpty() }?.sanitize(),
+                    assets = current.assets?.copy(
+                        largeText = largeText?.takeIf { it.isNotEmpty() }?.sanitize(),
+                        smallText = smallText?.takeIf { it.isNotEmpty() }?.sanitize()
+                    )
+                )
+            )
+        )
+        presence = updated
+        discordWebSocket.sendActivity(updated)
+    }
 }
